---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { Image } from "astro:assets";
export async function getStaticPaths() {
    const books = await getCollection("bookS");
    return books.map((book) => {
        return {
            params: { id: book.id },
            props: { book },
        };
    });
}

const { book } = Astro.props;
console.log("DEBUG [id].astro - params:", Astro.params, "hasBook:", !!book);
if (!book) {
    throw new Error(
        `El libro no está definido para los parámetros: ${JSON.stringify(Astro.params)}. Las props recibidas son: ${JSON.stringify(Astro.props)}`,
    );
}
const { data } = book;
const { title, author, volume, cover_image, description, buy, publishedDate } =
    data;
const { Content } = await render(book);
---

<Layout title={`${title} - AnimeBooks`}>
    <main class="space-y-8">
        <a
            href={import.meta.env.BASE_URL}
            class="inline-flex items-center gap-2 text-sm text-gray-400 hover:text-white transition-colors duration-200 group"
        >
            <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="2.5"
                stroke="currentColor"
                class="w-4 h-4 group-hover:-translate-x-1 transition-transform"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18"></path>
            </svg>
            Volver al catálogo
        </a>

        <div class="flex flex-col md:flex-row gap-12 mt-4">
            <!-- Columna Portada e Info de Compra -->
            <div class="w-full md:w-80 shrink-0 space-y-6">
                <div
                    class="overflow-hidden rounded-2xl border border-white/10 shadow-2xl shadow-violet-500/5 aspect-[3/4] bg-white/5 relative group"
                >
                    <Image
                        src={`/src/image/${cover_image}`}
                        alt={`Portada de ${title}`}
                        width={400}
                        height={600}
                        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                    />
                </div>

                <div class="space-y-3 pt-2">
                    <h3
                        class="text-xs font-semibold text-gray-400 uppercase tracking-wider"
                    >
                        Enlaces de compra
                    </h3>
                    <div class="flex flex-col gap-3">
                        {
                            buy.Amazon && (
                                <a
                                    href={buy.Amazon}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="w-full py-3 px-4 rounded-xl text-center font-bold text-sm bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-400 hover:to-amber-500 text-black shadow-md hover:shadow-amber-500/10 transition-all flex items-center justify-center gap-2"
                                >
                                    <svg
                                        class="w-4 h-4 fill-black shrink-0"
                                        viewBox="0 0 24 24"
                                    >
                                        <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1.07 14.85c-1.39 0-2.45-.63-3.13-1.89l.86-.53c.53.94 1.25 1.39 2.22 1.39 1.19 0 1.94-.61 1.94-2.12v-.3c-.56.63-1.42.94-2.38.94-2.01 0-3.41-1.48-3.41-3.69 0-2.31 1.48-3.77 3.41-3.77.98 0 1.83.33 2.38.98v-.81h1.16v6.86c0 2.23-1.28 3.25-3.05 3.25zm.07-7.79c-1.25 0-2.17.92-2.17 2.37 0 1.41.92 2.35 2.17 2.35s2.17-.94 2.17-2.35c0-1.45-.92-2.37-2.17-2.37z" />
                                    </svg>
                                    Comprar en Amazon
                                </a>
                            )
                        }
                        {
                            buy.Fnac && (
                                <a
                                    href={buy.Fnac}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="w-full py-3 px-4 rounded-xl text-center font-bold text-sm bg-yellow-500 text-black hover:bg-yellow-400 shadow-md transition-all flex items-center justify-center gap-2"
                                >
                                    <span class="bg-black text-white px-1.5 py-0.5 text-[9px] font-black rounded uppercase">
                                        Fnac
                                    </span>
                                    Comprar en Fnac
                                </a>
                            )
                        }
                        {
                            buy.BookDepository && (
                                <a
                                    href={buy.BookDepository}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="w-full py-3 px-4 rounded-xl text-center font-bold text-sm bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-500 hover:to-indigo-500 text-white shadow-md hover:shadow-indigo-500/10 transition-all flex items-center justify-center gap-2"
                                >
                                    Comprar en Book Depository
                                </a>
                            )
                        }
                    </div>
                </div>
            </div>

            <!-- Columna Contenido del Libro -->
            <div class="flex-1 space-y-6">
                <div>
                    <h1
                        class="text-3xl md:text-5xl font-extrabold tracking-tight text-white mb-2 leading-tight"
                    >
                        {title}
                    </h1>
                    <p class="text-lg text-violet-300 font-medium">
                        Por <span class="text-white font-semibold"
                            >{author}</span
                        >
                    </p>
                </div>

                <div class="flex flex-wrap gap-3">
                    <span
                        class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-violet-500/10 text-violet-300 border border-violet-500/20"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke-width="2"
                            stroke="currentColor"
                            class="w-3.5 h-3.5"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25"
                            ></path>
                        </svg>
                        {volume}
                        {volume === 1 ? "Tomo" : "Tomos"}
                    </span>
                    <span
                        class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-pink-500/10 text-pink-300 border border-pink-500/20"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke-width="2"
                            stroke="currentColor"
                            class="w-3.5 h-3.5"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5"
                            ></path>
                        </svg>
                        Publicado: {publishedDate}
                    </span>
                </div>

                <div class="h-px bg-white/10 w-full"></div>

                <div
                    class="prose prose-invert max-w-none text-gray-300 leading-relaxed text-base space-y-4"
                >
                    <Content />
                </div>
            </div>
        </div>
    </main>
</Layout>

<style>
    /* Estilos personalizados para el contenido Markdown */
    .prose :global(p) {
        margin-bottom: 1.25rem;
    }
</style>
