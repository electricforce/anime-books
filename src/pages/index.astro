---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
const books = await getCollection("bookS");
---

<Layout title="AnimeBooks - Catálogo de Mangas y Libros">
	<main class="space-y-16">
		<header class="text-center space-y-4">
			<h1 class="text-5xl md:text-7xl font-extrabold tracking-tight bg-gradient-to-r from-violet-400 via-fuchsia-400 to-pink-500 bg-clip-text text-transparent drop-shadow-sm">
				Anime <span class="block mt-2 text-white font-medium text-4xl md:text-5xl">Books Portal</span>
			</h1>
			<p class="text-gray-400 max-w-md mx-auto text-sm md:text-base font-light">
				Descubre tus obras favoritas, consulta información y encuentra enlaces directos para adquirirlas al mejor precio.
			</p>
		</header>

		<section aria-label="Lista de libros disponibles">
			<div class="mx-auto max-w-5xl">
				<div class="grid gap-8 md:grid-cols-2">
					{
						books.map((book) => {
							const { id, data } = book;
							const {
								title,
								author,
								volume,
								cover_image,
								description,
							} = data;

							return (
								<article class="flex flex-col sm:flex-row gap-6 p-5 rounded-2xl bg-white/5 border border-white/10 backdrop-blur-md hover:border-violet-500/50 hover:bg-white/10 hover:shadow-2xl hover:shadow-violet-500/10 transition-all duration-300 group">
									<a
										href={`/books/${id}`}
										class="w-full sm:w-40 shrink-0 overflow-hidden rounded-xl shadow-md group-hover:scale-[1.03] transition-transform duration-300"
									>
										<img
											src={`/${cover_image}`}
											alt={`Portada de ${title}`}
											class="w-full h-auto object-cover rounded-xl aspect-[3/4]"
											loading="lazy"
										/>
									</a>
									
									<div class="flex flex-col justify-between py-1">
										<div>
											<span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-violet-500/10 text-violet-300 border border-violet-500/20 mb-3">
												{volume} {volume === 1 ? 'Tomo' : 'Tomos'}
											</span>
											
											<h2 class="text-xl md:text-2xl font-bold tracking-tight text-white mb-1 group-hover:text-fuchsia-400 transition-colors">
												<a href={`/books/${id}`}>
													{title}
												</a>
											</h2>
											
											<p class="text-xs text-gray-400 mb-3">
												Por <span class="text-gray-300 font-semibold">{author}</span>
											</p>

											<p class="text-sm text-gray-300 leading-relaxed line-clamp-3 mb-4">
												{description}
											</p>
										</div>
										
										<a
											href={`/anime-books/books/${id}`}
											class="inline-flex items-center gap-1.5 text-xs font-semibold text-violet-400 group-hover:text-violet-300 group-hover:translate-x-1 transition-all"
										>
											Ver detalles y comprar
											<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-3 h-3">
												<path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
											</svg>
										</a>
									</div>
								</article>
							);
						})
					}
				</div>
			</div>
		</section>
	</main>
</Layout>

